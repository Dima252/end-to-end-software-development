<?xml version="1.0" encoding="UTF-8"?>
<!-- Logging configuration of workshop-cli (packed into the uber jar). -->
<Configuration status="warn">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level [%c{1}] %msg%n" charset="UTF-8"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- Our own code: every creation (info) and every rejected operation (warn) -->
        <Logger name="patmal.workshops.student.impl" level="info"/>
        <!-- Everything else (libraries): only warnings and errors -->
        <Root level="warn">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
