<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- app: the runnable command line application (workshop-cli) -->
    <parent>
        <groupId>patmal.workshops.student.impl</groupId>
        <artifactId>workshop-system</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>app</artifactId>

    <name>Workshop Registration System - app</name>

    <properties>
        <!-- -DskipTests skips the course tester in verify as well -->
        <skipTests>false</skipTests>
    </properties>

    <dependencies>
        <!-- The implementation that Main instantiates -->
        <dependency>
            <groupId>patmal.workshops.student.impl</groupId>
            <artifactId>logic-impl</artifactId>
        </dependency>

        <!-- Main works through the API interfaces; logic has no pom, so model is declared too -->
        <dependency>
            <groupId>patmal.workshops</groupId>
            <artifactId>logic</artifactId>
        </dependency>
        <dependency>
            <groupId>patmal.workshops</groupId>
            <artifactId>model</artifactId>
        </dependency>

        <!-- Main logs through the Log4j API -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>

        <!-- Log4j backend: nothing compiles against it, but it is packed into the uber jar -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>

        <!-- Course tester, run in verify against the uber jar. Scope test (from the root), so it is
             never packed into workshop-cli.jar -->
        <dependency>
            <groupId>patmal.workshops</groupId>
            <artifactId>workshop-tester</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- The uber jar is target/workshop-cli.jar -->
        <finalName>workshop-cli</finalName>

        <plugins>
            <!-- Uber jar: the application with all its compile and runtime dependencies
                 (test-scope libraries are left out). Version in the root pluginManagement. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <!-- workshop-cli.jar, not workshop-cli-jar-with-dependencies.jar -->
                    <appendAssemblyId>false</appendAssemblyId>
                    <archive>
                        <manifest>
                            <mainClass>patmal.workshops.student.impl.app.Main</mainClass>
                        </manifest>
                        <manifestEntries>
                            <!-- log4j-api holds Java 9+ class versions under META-INF/versions -->
                            <Multi-Release>true</Multi-Release>
                        </manifestEntries>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>uber-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Sets the property ${patmal.workshops:workshop-tester:jar} to the path of the tester jar
                 in the local repository -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>locate-tester</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Bonus: the build runs the course tester against the uber jar, exactly like guide
                 section 7, in a separate JVM. A non-zero exit code of the tester fails the build. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>run-tester</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <executable>${java.home}/bin/java</executable>
                            <workingDirectory>${project.build.directory}</workingDirectory>
                            <arguments>
                                <!-- only errors from our own logging, so the tester's report stays readable -->
                                <argument>-Dworkshop.log.level=error</argument>
                                <argument>-cp</argument>
                                <argument>${patmal.workshops:workshop-tester:jar}${path.separator}${project.build.directory}/${project.build.finalName}.jar</argument>
                                <argument>patmal.workshops.main.Main</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
