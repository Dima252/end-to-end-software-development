<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Root: aggregator of core and app, and top parent of every module -->
    <groupId>patmal.workshops.student.impl</groupId>
    <artifactId>workshop-system</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Workshop Registration System</name>

    <modules>
        <module>core</module>
        <module>app</module>
    </modules>

    <properties>
        <!-- Build settings -->
        <java.version>25</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Given course jars (installed with install:install-file, see README.md) -->
        <workshops.api.version>2.0</workshops.api.version>
        <workshops.tester.version>2.0</workshops.tester.version>

        <!-- Library versions -->
        <log4j.version>2.26.1</log4j.version>
        <commons-validator.version>1.11.0</commons-validator.version>
        <jackson.version>3.2.4</jackson.version>
        <junit.version>6.1.3</junit.version>

        <!-- Plugin versions -->
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Course API: interfaces only, no pom, so no transitive dependencies -->
            <dependency>
                <groupId>patmal.workshops</groupId>
                <artifactId>model</artifactId>
                <version>${workshops.api.version}</version>
            </dependency>
            <dependency>
                <groupId>patmal.workshops</groupId>
                <artifactId>logic</artifactId>
                <version>${workshops.api.version}</version>
            </dependency>

            <!-- Logging: the code uses log4j-api only; log4j-core is the backend, chosen by app -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>${log4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>${log4j.version}</version>
                <scope>runtime</scope>
            </dependency>

            <!-- E-mail validation (brings commons-beanutils, -digester, -logging, -collections) -->
            <dependency>
                <groupId>commons-validator</groupId>
                <artifactId>commons-validator</artifactId>
                <version>${commons-validator.version}</version>
            </dependency>

            <!-- JSON exports (brings jackson-core and jackson-annotations) -->
            <dependency>
                <groupId>tools.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <!-- Course tester: needed by the build only, never packed into the uber jar -->
            <dependency>
                <groupId>patmal.workshops</groupId>
                <artifactId>workshop-tester</artifactId>
                <version>${workshops.tester.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- Test libraries: never packed into the uber jar -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- Our own modules -->
            <dependency>
                <groupId>patmal.workshops.student.impl</groupId>
                <artifactId>model-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>patmal.workshops.student.impl</groupId>
                <artifactId>logic-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <!-- Used from the command line (dependency:tree, dependency:analyze). Pinned because
                     the default version Maven picks (3.7.0) cannot read Java 25 class files. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
