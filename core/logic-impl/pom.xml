<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- logic-impl: implementation of WorkshopSystem -->
    <parent>
        <groupId>patmal.workshops.student.impl</groupId>
        <artifactId>core</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>logic-impl</artifactId>

    <name>Workshop Registration System - logic-impl</name>

    <dependencies>
        <dependency>
            <groupId>patmal.workshops.student.impl</groupId>
            <artifactId>model-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>patmal.workshops</groupId>
            <artifactId>logic</artifactId>
        </dependency>
        <!-- The logic jar has no pom: the model interfaces it uses must be declared here -->
        <dependency>
            <groupId>patmal.workshops</groupId>
            <artifactId>model</artifactId>
        </dependency>

        <!-- The managers log through the Log4j API only -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>

        <!-- E-mail validation in createStudent and createInstructor -->
        <dependency>
            <groupId>commons-validator</groupId>
            <artifactId>commons-validator</artifactId>
        </dependency>

        <!-- Log4j backend for the own tests only (the application's backend comes from app) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Own tests (scope test, managed in the root) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>
</project>
